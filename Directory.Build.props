<Project>
  <!-- Общие настройки всех проектов решения. Версия приложения — одна, здесь: её читают сборка,
       User-Agent (`melogold-windows/<версия>`, API §1.2), установщик и update.json (scripts/release.ps1). -->
  <PropertyGroup>
    <MelogoldVersion>0.1.6</MelogoldVersion>
    <Version>$(MelogoldVersion)</Version>
    <AssemblyVersion>$(MelogoldVersion).0</AssemblyVersion>
    <FileVersion>$(MelogoldVersion).0</FileVersion>
    <InformationalVersion>$(MelogoldVersion)</InformationalVersion>
    <Company>Melogold</Company>
    <Product>Melogold</Product>
    <Copyright>Melogold contributors, GPL-3.0</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
