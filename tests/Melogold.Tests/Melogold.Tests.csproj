<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Melogold.Core\Melogold.Core.csproj" />
    <ProjectReference Include="..\..\src\Melogold.InnerTube\Melogold.InnerTube.csproj" />
    <ProjectReference Include="..\..\src\Melogold.Server\Melogold.Server.csproj" />
    <ProjectReference Include="..\..\src\Melogold.Playback\Melogold.Playback.csproj" />
  </ItemGroup>

  <!-- Векторы правил, общие с сервером и Android (spec/README.md) -->
  <ItemGroup>
    <None Include="..\..\spec\*.json" Link="spec\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\stream-clients.json" Link="config\stream-clients.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
