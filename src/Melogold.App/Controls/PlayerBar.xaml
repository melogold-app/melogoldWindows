<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Melogold.App.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Melogold.App.Controls"
    xmlns:app="using:Melogold.App"
    x:Name="Root">

    <Grid
        x:Name="Bar"
        MinHeight="88"
        Padding="12,8,16,8"
        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="16"
        RowSpacing="2">
        <!-- Боковые колонки всегда равной ширины: Play стоит посередине окна (там же середина «Сейчас играет»).
             Ширина колонок — по кнопкам справа в каждом состоянии, см. VisualStateManager внизу -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="320" />
            <ColumnDefinition x:Name="CenterColumn" Width="2*" MaxWidth="640" />
            <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Слева: обложка, название, исполнитель, ♡. Правый клик — то же меню, что «…» -->
        <Grid x:Name="TrackInfo" Grid.RowSpan="2" VerticalAlignment="Center" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay}" ContextRequested="OnTrackContextRequested">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ArtworkButton"
                x:Uid="PlayerArtwork"
                Width="56"
                Height="56"
                Padding="0"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="0"
                Click="OnArtworkClick">
                <Image Source="{x:Bind app:Images.Player(ViewModel.ArtworkUrl), Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <HyperlinkButton
                    Padding="0"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Click="OnTitleClick">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" IsTextTrimmedChanged="OnTextTrimmedChanged" />
                </HyperlinkButton>
                <Grid>
                    <HyperlinkButton
                        x:Name="SubtitleLink"
                        Padding="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.ShowSubtitle, Mode=OneWay}"
                        Click="OnArtistClick">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" IsTextTrimmedChanged="OnTextTrimmedChanged" />
                    </HyperlinkButton>
                    <TextBlock
                        x:Name="ResolvingText"
                        x:Uid="ResolvingText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Getting the stream…"
                        Visibility="{x:Bind ViewModel.ShowResolvingText, Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind local:PlayerBar.IsSet(ViewModel.ErrorMessage), Mode=OneWay}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <HyperlinkButton x:Uid="RetryLink" Padding="0" Content="Retry" FontSize="12" Command="{x:Bind ViewModel.RetryCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <ToggleButton
                x:Name="LikeButton"
                x:Uid="PlayerLike"
                Grid.Column="2"
                Style="{StaticResource PlayerIconToggleStyle}"
                IsChecked="{x:Bind ViewModel.IsLiked, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleLikeCommand}">
                <FontIcon Glyph="{x:Bind local:PlayerBar.HeartGlyph(ViewModel.IsLiked), Mode=OneWay}" />
            </ToggleButton>
        </Grid>

        <!-- В центре: кнопки и ползунок; в узком окне ползунок — строкой сверху во всю ширину -->
            <StackPanel x:Name="Transport" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <ToggleButton
                    x:Name="ShuffleButton"
                    x:Uid="PlayerShuffle"
                    Style="{StaticResource PlayerIconToggleStyle}"
                    IsChecked="{x:Bind ViewModel.Shuffle, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleShuffleCommand}">
                    <FontIcon Glyph="&#xE8B1;" />
                </ToggleButton>
                <Button x:Uid="PlayerPrevious" Style="{StaticResource PlayerIconButtonStyle}" Command="{x:Bind ViewModel.PreviousCommand}">
                    <FontIcon Glyph="&#xE892;" />
                </Button>
                <Grid>
                    <Button
                        x:Name="PlayButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        CornerRadius="20"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind local:PlayerBar.Hint(ViewModel.PlayPauseLabel, 'Space'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.PlayPauseCommand}">
                        <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                    </Button>
                    <ProgressRing
                        Width="44"
                        Height="44"
                        IsHitTestVisible="False"
                        IsActive="{x:Bind ViewModel.IsResolving, Mode=OneWay}" />
                </Grid>
                <Button x:Uid="PlayerNext" Style="{StaticResource PlayerIconButtonStyle}" Command="{x:Bind ViewModel.NextCommand}">
                    <FontIcon Glyph="&#xE893;" />
                </Button>
                <ToggleButton
                    x:Name="RepeatButton"
                    Style="{StaticResource PlayerIconToggleStyle}"
                    IsChecked="{x:Bind local:PlayerBar.IsRepeat(ViewModel.Repeat), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.RepeatLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:PlayerBar.Hint(ViewModel.RepeatLabel, 'Ctrl+T'), Mode=OneWay}"
                    Command="{x:Bind ViewModel.CycleRepeatCommand}">
                    <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" />
                </ToggleButton>
            </StackPanel>
            <Grid x:Name="SeekRow" Grid.Row="1" Grid.Column="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Slider
                    x:Name="SeekSlider"
                    x:Uid="PlayerSeek"
                    Grid.Column="1"
                    Minimum="0"
                    StepFrequency="1"
                    SmallChange="5"
                    LargeChange="15"
                    Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Position, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    ThumbToolTipValueConverter="{StaticResource TimeConverter}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>

        <!-- Справа: «Текст», «Очередь», громкость, мини-плеер и «…» -->
        <StackPanel x:Name="RightPanel" Grid.Column="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
            <ToggleButton
                x:Name="LyricsButton"
                x:Uid="PlayerLyricsButton"
                Style="{StaticResource PlayerIconToggleStyle}"
                IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                Click="OnLyricsClick">
                <FontIcon Glyph="&#xED1E;" />
            </ToggleButton>
            <ToggleButton
                x:Name="QueueButton"
                x:Uid="PlayerQueueButton"
                Style="{StaticResource PlayerIconToggleStyle}"
                Click="OnQueueClick">
                <FontIcon Glyph="&#xE90B;" />
            </ToggleButton>
            <!-- Колесо мыши над громкостью меняет её, как в «Медиаплеере» -->
            <StackPanel x:Name="VolumePanel" Orientation="Horizontal" Spacing="4" Background="Transparent" PointerWheelChanged="OnVolumeWheel">
                <Button x:Name="MuteButton" x:Uid="PlayerMute" Style="{StaticResource PlayerIconButtonStyle}" Command="{x:Bind ViewModel.ToggleMuteCommand}">
                    <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                </Button>
                <Slider
                    x:Name="VolumeSlider"
                    x:Uid="PlayerVolume"
                    Width="100"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="1"
                    SmallChange="5"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </StackPanel>
            <!-- Окно уже: громкость — кнопкой, ползунок и «Без звука» — в панели над ней, как в «Медиаплеере» Windows
                 (пользователь, 2026-09-26: кнопка звука пропадала, а оставшаяся только выключала звук) -->
            <Button
                x:Name="VolumeButton"
                x:Uid="PlayerVolumeButton"
                Style="{StaticResource PlayerIconButtonStyle}"
                Visibility="Collapsed"
                PointerWheelChanged="OnVolumeWheel">
                <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8" PointerWheelChanged="OnVolumeWheel">
                            <Button x:Uid="PlayerMute" Style="{StaticResource PlayerIconButtonStyle}" Command="{x:Bind ViewModel.ToggleMuteCommand}">
                                <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                            </Button>
                            <Slider
                                x:Uid="PlayerVolume"
                                Width="180"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                SmallChange="5"
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                            <TextBlock
                                MinWidth="28"
                                VerticalAlignment="Center"
                                TextAlignment="Right"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.VolumeText, Mode=OneWay}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="MiniButton"
                x:Uid="PlayerMiniButton"
                Style="{StaticResource PlayerIconButtonStyle}"
                IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                Click="OnMiniClick">
                <FontIcon Glyph="&#xE944;" />
            </Button>
            <!-- «…»: одно меню на всё — трек, текст, таймер сна, сведения о потоке (собирается при нажатии) -->
            <Button
                x:Name="MoreButton"
                x:Uid="PlayerMore"
                Style="{StaticResource PlayerIconButtonStyle}"
                IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                Click="OnMoreClick">
                <FontIcon Glyph="&#xE712;" />
            </Button>
        </StackPanel>

        <!-- Ширина окна (панель во всю ширину): что остаётся на виду. Спрятанное — в начале меню «…» (PlayerBar.BuildMenu) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Всё: ползунок громкости, мини-плеер -->
                <VisualState x:Name="Full">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Громкость — кнопкой с ползунком в панели -->
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumePanel.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeButton.Visibility" Value="Visible" />
                        <Setter Target="LeftColumn.MinWidth" Value="216" />
                        <Setter Target="RightColumn.MinWidth" Value="216" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Справа только «Текст», «Очередь», громкость и «…» -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumePanel.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeButton.Visibility" Value="Visible" />
                        <Setter Target="MiniButton.Visibility" Value="Collapsed" />
                        <Setter Target="LeftColumn.MinWidth" Value="200" />
                        <Setter Target="RightColumn.MinWidth" Value="200" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Две строки, как «Медиаплеер» Windows: перемотка сверху во всю ширину, под ней трек, ⏮ ⏯ ⏭, «Текст»,
                     «Очередь», громкость и «…»; ♡, перемешать и повтор — в «…» -->
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumePanel.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeButton.Visibility" Value="Visible" />
                        <Setter Target="MiniButton.Visibility" Value="Collapsed" />
                        <Setter Target="LikeButton.Visibility" Value="Collapsed" />
                        <Setter Target="ShuffleButton.Visibility" Value="Collapsed" />
                        <Setter Target="RepeatButton.Visibility" Value="Collapsed" />
                        <Setter Target="SeekRow.(Grid.Row)" Value="0" />
                        <Setter Target="SeekRow.(Grid.Column)" Value="0" />
                        <Setter Target="SeekRow.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="Transport.(Grid.Row)" Value="1" />
                        <Setter Target="TrackInfo.(Grid.Row)" Value="1" />
                        <Setter Target="TrackInfo.(Grid.RowSpan)" Value="1" />
                        <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanel.(Grid.RowSpan)" Value="1" />
                        <Setter Target="CenterColumn.Width" Value="Auto" />
                        <Setter Target="LeftColumn.MinWidth" Value="128" />
                        <Setter Target="RightColumn.MinWidth" Value="128" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
