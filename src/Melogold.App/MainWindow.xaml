<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Melogold.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Melogold.App.Controls"
    xmlns:local="using:Melogold.App"
    Title="Melogold">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Строка заголовка: «Назад», меню-гамбургер в узком окне, иконка, «Melogold», поиск по центру (§5.1) -->
        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Title="Melogold"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="False"
            BackRequested="OnTitleBarBackRequested"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/melogold-256.png" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="SearchBox"
                Width="320"
                VerticalAlignment="Center"
                PlaceholderText="Search"
                QueryIcon="Find"
                UpdateTextOnSelect="False"
                GotFocus="OnSearchGotFocus"
                QuerySubmitted="OnSearchQuerySubmitted"
                TextChanged="OnSearchTextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="local:SuggestionVm">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Detail}"
                                    Visibility="{x:Bind HasDetail}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="240"
            DisplayModeChanged="OnNavDisplayModeChanged"
            ItemInvoked="OnNavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavTrends" Content="Trends" Tag="trends">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavNew" Content="New" Tag="new">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavLibrary" Content="Library" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Стеки разделов: у каждого свой Frame, видим один -->
            <Grid x:Name="SectionHost" />
        </NavigationView>

        <!-- Плашка над плеером: одна, «Отменить» (§5.5) -->
        <Grid
            x:Name="SnackbarHost"
            Grid.Row="2"
            Margin="12,0,12,8"
            Padding="16,8,8,8"
            HorizontalAlignment="Center"
            MinWidth="320"
            MaxWidth="640"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            ColumnSpacing="12"
            Visibility="{x:Bind Snackbar.IsOpen, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{x:Bind Snackbar.Message, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <Button
                Grid.Column="1"
                Content="{x:Bind Snackbar.ActionText, Mode=OneWay}"
                Visibility="{x:Bind local:MainWindow.IsSet(Snackbar.ActionText), Mode=OneWay}"
                Click="OnSnackbarAction" />
        </Grid>

        <!-- Панель воспроизведения во всю ширину окна (§5.2) -->
        <controls:PlayerBar x:Name="Player" Grid.Row="3" />
    </Grid>
</Window>
