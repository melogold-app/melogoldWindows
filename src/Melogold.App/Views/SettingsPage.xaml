<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Melogold.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Melogold.App.Controls">
    <ScrollViewer x:Name="Scroller">
        <StackPanel Margin="{StaticResource PageContentMargin}" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleStyle}" Text="Settings" />

            <!-- Вышла новая версия (§3): карточка, пока обновление не установлено -->
            <toolkit:SettingsCard x:Name="UpdateCard" Visibility="Collapsed">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar x:Name="UpdateProgress" Width="160" VerticalAlignment="Center" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="WhatsNewButton" Click="OnWhatsNew" />
                    <Button x:Name="UpdateButton" Style="{StaticResource AccentButtonStyle}" Click="OnUpdate" />
                </StackPanel>
            </toolkit:SettingsCard>

            <!-- Аккаунт и сервер (Android AccountCard и ServerSettingsRow): текст — в коде, по состоянию -->
            <controls:ClickableCard x:Name="AccountCard" Activated="OnAccountClick">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon x:Name="AccountIcon" Glyph="&#xE77B;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel x:Name="AccountButtons" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" Click="OnSignIn" />
                    <Button x:Name="RegisterButton" Click="OnRegister" />
                </StackPanel>
            </controls:ClickableCard>
            <controls:ClickableCard x:Name="ServerCard" x:Uid="SettingsServer" Header="Melogold server" Activated="OnServerClick">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </toolkit:SettingsCard.HeaderIcon>
            </controls:ClickableCard>

            <!-- Внешний вид -->
            <TextBlock x:Uid="SettingsAppearance" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Appearance" />
            <toolkit:SettingsCard x:Uid="SettingsTheme" Header="Theme">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem x:Uid="ThemeSystem" Content="System default" Tag="System" />
                    <ComboBoxItem x:Uid="ThemeLight" Content="Light" Tag="Light" />
                    <ComboBoxItem x:Uid="ThemeDark" Content="Dark" Tag="Dark" />
                </ComboBox>
            </toolkit:SettingsCard>

            <!-- Воспроизведение: скорость для всех треков, нормализация, сведения о потоке (§5.4) -->
            <TextBlock x:Uid="SettingsPlayback" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Playback" />
            <toolkit:SettingsCard x:Uid="SettingsSpeed" Header="Playback speed" Description="For all tracks">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC4A;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="SpeedBox" MinWidth="200" SelectionChanged="OnSpeedChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="SettingsNormalize" Header="Loudness normalization" Description="Keeps tracks at the same loudness">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="NormalizeSwitch" Toggled="OnNormalizeToggled" />
            </toolkit:SettingsCard>
            <controls:ClickableCard x:Name="StreamInfoCard" x:Uid="SettingsStreamInfo" Header="Stream info" Activated="OnStreamInfo">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
            </controls:ClickableCard>

            <!-- Библиотека и история (Android DatabaseSettings) -->
            <TextBlock x:Uid="SettingsLibrary" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Library and history" />
            <toolkit:SettingsCard x:Uid="SettingsPauseHistory" Header="Pause playback history">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="PauseHistorySwitch" Toggled="OnPauseHistoryToggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="SettingsPauseSearch" Header="Pause search history">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE721;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="PauseSearchSwitch" Toggled="OnPauseSearchToggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="SearchHistoryCard" x:Uid="SettingsSearchHistory" Header="Search history">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="ClearSearchesButton" x:Uid="ClearSearchesButton" Content="Clear" Click="OnClearSearches" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="HiddenCard" x:Uid="SettingsHidden" Header="Blacklist">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8F8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="ResetHiddenButton" x:Uid="ResetHiddenButton" Content="Reset" Click="OnResetHidden" />
            </toolkit:SettingsCard>

            <!-- Хранилище и данные: кэш и его очистка -->
            <TextBlock x:Uid="SettingsStorage" Style="{StaticResource SettingsSectionHeaderStyle}" Text="Storage and data" />
            <toolkit:SettingsCard x:Name="CacheCard" x:Uid="SettingsCache" Header="Cache">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="ClearCacheButton" x:Uid="ClearCacheButton" Content="Clear" Click="OnClearCache" />
            </toolkit:SettingsCard>

            <!-- О приложении -->
            <TextBlock x:Uid="SettingsAbout" Style="{StaticResource SettingsSectionHeaderStyle}" Text="About" />
            <toolkit:SettingsCard x:Name="VersionCard" x:Uid="SettingsVersion" Header="Melogold">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/melogold-256.png" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Name="CheckUpdatesButton" x:Uid="CheckUpdatesButton" Content="Check for updates" Click="OnCheckUpdates" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="SettingsDiagnostics" Header="Diagnostics" Description="App logs">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Uid="OpenLogs" Content="Open folder" Click="OnOpenLogs" />
            </toolkit:SettingsCard>
            <controls:ClickableCard x:Uid="SettingsSource" Header="Source code" Description="GPL-3.0" Activated="OnOpenSource">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;" />
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </toolkit:SettingsCard.ActionIcon>
            </controls:ClickableCard>
            <controls:ClickableCard x:Uid="SettingsLicenses" Header="Licenses" Activated="OnLicenses">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsCard.HeaderIcon>
            </controls:ClickableCard>
        </StackPanel>
    </ScrollViewer>
</Page>
